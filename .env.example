# Copy this file to .env and fill in real values before deploying.

# Flask secret key - generate a strong random key in production!
SECRET_KEY=change-this-to-a-long-random-secret-before-deployment

# Database URL. SQLite works out of the box on Render.
# For production, use a managed Postgres database instead:
# DATABASE_URL=postgres://user:password@host:port/database
DATABASE_URL=sqlite:///medicine.db

# VAPID keys for Web Push notifications.
# Generate new keys with: python -c "from pywebpush import WebPush; import json; keys=WebPush.generate_vapid_keys(); print(keys)"
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CLAIMS_EMAIL=mailto:your-email@example.com

# Twilio credentials for SMS alerts to emergency contacts.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+12345678900